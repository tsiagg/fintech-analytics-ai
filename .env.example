# Copy to .env and adjust. Used by infra/docker-compose.yml (Postgres + Airflow)
# and by the Streamlit app (Phase 4 BI Assistant / AI CFO).
#
#   Copy-Item .env.example .env
#
# Never commit .env — it is gitignored.

# --- Postgres (simulation, dbt, Streamlit) ---
POSTGRES_HOST=localhost
POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech_dev_change_me
POSTGRES_DB=fintech
# Host port if 5432 is already taken on your machine
POSTGRES_PORT=5432

# --- Airflow (Phase 3) ---
# UI: http://localhost:8080
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Optional: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# AIRFLOW_FERNET_KEY=

# --- OpenRouter (BI Assistant + AI CFO) ---
# Create key: https://openrouter.ai/keys — set a ~$15/month spend limit in OpenRouter settings.
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=

# BI Assistant: Flash by default; Pro for root-cause / compare / anomaly (auto-routing in app)
LLM_MODEL_BI_FLASH=deepseek/deepseek-v4-flash
LLM_MODEL_BI_PRO=deepseek/deepseek-v4-pro

# AI CFO: approximately one structured report per day
LLM_MODEL_CFO=google/gemini-3.1-pro-preview
